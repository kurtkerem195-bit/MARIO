        folder = self.snd.folder or "-"
        if len(folder) > 70:
            folder = "…" + folder[-69:]
        c.create_text(W / 2, 436, text="Ses dosyaları: " + folder, font=("Arial", 9), fill="#8888bb")
        c.create_text(W / 2, 454, text="Ses gelmiyorsa 'Ses sihirbazı'nı çalıştır.   ▲▼ ◀▶ ENTER ESC",
                      font=("Arial", 9), fill="#8888bb")

    # ---- çizim: dükkan
    def draw_shop(self):
        c = self.canvas
        c.create_rectangle(0, 0, W, H, fill="#1b1b3a", outline="")
        c.create_text(20, 14, text="MARİO'YU ÖZELLEŞTİR", anchor="nw",
                      font=("Arial", 20, "bold"), fill="white")
        c.create_text(W - 20, 16, text=f"XP: {self.save['xp']}", anchor="ne",
                      font=("Arial", 18, "bold"), fill="#7df9ff")
        pcol = "white" if self.shop_player == 0 else "#9dff9d"
        c.create_text(W - 20, 48, text=f"TAB: oyuncu değiştir  —  şu an OYUNCU {self.shop_player + 1}",
                      anchor="ne", font=("Arial", 11, "bold"), fill=pcol)

        # Önizleme (seçili seçenek anında denenir)
        base = self.equipped_of(self.shop_player)
        eq = {"hat": base["hat"], "overall": base["overall"], "boots": base["boots"],
              "acc": list(base["acc"])}
        key, _, opts = CATS[self.shop_row]
        oid = opts[self.shop_col[self.shop_row]][0]
        if key == "acc":
            if oid not in eq["acc"]:
                eq["acc"] = (eq["acc"] + [oid])[-MAX_ACC:]
        else:
            eq[key] = oid
        c.create_rectangle(25, 80, 250, 430, fill="#2a2a55", outline="#6666aa", width=2)
        c.create_text(137, 100, text=f"OYUNCU {self.shop_player + 1}", font=("Arial", 12, "bold"), fill=pcol)
        c.create_oval(65, 285, 210, 305, fill="#1a1a33", outline="")
        step = 3 if (self.frame // 12) % 2 else 0
        draw_mario(c, 137 - 14 * 3.2, 170, 1, resolve_look(eq), 3.2, step)
        c.create_text(137, 335, text=opts[self.shop_col[self.shop_row]][1],
                      font=("Arial", 14, "bold"), fill="white")
        c.create_text(137, 358, text=CATS[self.shop_row][1].split("  ")[0],
                      font=("Arial", 9), fill="#aaaadd")

        # Seçenek kutuları (4 satır)
        for i, (ckey, label, copts) in enumerate(CATS):
            top = 98 + i * 88
            c.create_text(275, top - 4, text=label, anchor="sw",
                          font=("Arial", 11, "bold"), fill="#ffd966")
            for j, (oid2, name, col, cost) in enumerate(copts):
                x = 275 + j * 82
                owned = f"{ckey}:{oid2}" in self.save["owned"]
                if ckey == "acc":
                    equipped = oid2 in base["acc"]
                else:
                    equipped = base[ckey] == oid2
                selected = (i == self.shop_row and j == self.shop_col[i])
                c.create_rectangle(x, top, x + 76, top + 66, fill="#33336a",
                                   outline="#ffeb3b" if selected else "#5555aa",
                                   width=4 if selected else 2)
                if col:
                    c.create_rectangle(x + 18, top + 6, x + 58, top + 30, fill=col, outline="white")
                    c.create_text(x + 38, top + 41, text=name, font=("Arial", 9, "bold"), fill="white")
                    sy = top + 56
                else:
                    c.create_text(x + 38, top + 22, text=name, font=("Arial", 11, "bold"), fill="white")
                    sy = top + 50
                if equipped:
                    c.create_text(x + 38, sy, text="✔ TAKILI" if ckey == "acc" else "✔ SEÇİLİ",
                                  font=("Arial", 9, "bold"), fill="#6dff6d")
                elif owned:
                    c.create_text(x + 38, sy, text="Sende", font=("Arial", 9), fill="#cccccc")
                else:
                    afford = self.save["xp"] >= cost
                    c.create_text(x + 38, sy, text=f"{cost} XP", font=("Arial", 10, "bold"),
                                  fill="#7df9ff" if afford else "#ff7777")

        if self.shop_msg_t > 0:
            c.create_text(W / 2 + 100, 452, text=self.shop_msg, font=("Arial", 12, "bold"), fill="#ffeb3b")
        c.create_text(20, 470, text="▲▼ ◀▶: gez   ENTER: satın al / tak-çıkar   TAB: oyuncu   ESC: geri",
                      anchor="w", font=("Arial", 10), fill="#aaaadd")

    def draw(self):
        self.canvas.delete("all")
        if self.state == "menu":
            self.draw_menu()
        elif self.state == "settings":
            self.draw_settings()
        elif self.state == "wizard":
            self.draw_wizard()
        elif self.state == "controls":
            self.draw_controls()
        elif self.state == "shop":
            self.draw_shop()
        else:
            self.draw_world()
        if self.toast_t > 0:
            self.canvas.create_text(W / 2, 62, text=self.toast, fill="white",
                                    font=("Arial", 14, "bold"))
        self.canvas.letterbox()

    def tick(self):
        """Sabit zaman adımı: çizim yavaşlasa (tam ekran) bile oyun hızı değişmez."""
        t0 = time.perf_counter()
        self.acc = min(self.acc + (t0 - self.last_t), 0.1)
        self.last_t = t0
        steps = 0
        while self.acc >= STEP and steps < 4:
            self.update()
            self.acc -= STEP
            steps += 1
        if steps:
            self.draw()
        spent = int((time.perf_counter() - t0) * 1000)
        self.root.after(max(1, FRAME_MS - spent), self.tick)


def main():
    root = tk.Tk()
    root.title("Mini Mario - Python 3.13")
    root.resizable(False, False)
    Game(root)
    root.mainloop()


if __name__ == "__main__":
    main()
