def make_pipe_tile(top, left, base="#2cb52c"):
    p = Pix()
    outline = "#093a09"

    def col_at(x):
        t = (x + (0 if left else TILE)) / (2 * TILE - 1)
        if 0.10 <= t < 0.17:
            return "#a6f7a6"
        if 0.17 <= t < 0.22:
            return "#6ee06e"
        return mix(shade(base, 0.12), shade(base, -0.38), t)

    bx1, bx2 = (3, TILE) if left else (0, TILE - 3)          # gövde, dış kenarlardan içeride
    for y in range(TILE):
        for x in range(TILE):
            in_rim = top and y < 18
            in_body = bx1 <= x < bx2 and (not top or y >= 18)
            if in_rim:
                col = col_at(x)
                if y in (1, 2):
                    col = shade(col, 0.28)
                elif y in (14, 15, 16):
                    col = shade(col, -0.22)
                if y in (0, 17) or (left and x == 0) or (not left and x == TILE - 1):
                    col = outline
                p.px[y][x] = col
            elif in_body:
                col = col_at(x)
                if top and y < 21:
                    col = shade(col, -0.3)                    # başlığın gölgesi
                if (left and x == bx1) or (not left and x == bx2 - 1):
                    col = outline
                p.px[y][x] = col
    return p


# ---------------------------------------------------------------- Seviye kurulumu
def build_level(spec):
    """Karakterler: # zemin, S taş blok (merdiven), B tuğla, ? gizemli blok,
    U kullanılmış blok, T boru, o altın, F bayrak, . boşluk"""
    cols = spec["cols"]
    g = [["."] * cols for _ in range(ROWS)]
    for c in range(cols):
        if not any(a <= c <= b for a, b in spec["gaps"]):
            g[10][c] = g[11][c] = "#"
    for row, a, b in spec["bricks"]:
        for c in range(a, b + 1):
            g[row][c] = "B"
    for row, c in spec["qs"]:
        g[row][c] = "?"
    for col, h in spec["pipes"]:
        for hh in range(h):
            for dc in (0, 1):
                g[9 - hh][col + dc] = "T"
    for i in range(5):
        for hh in range(i + 1):
            g[9 - hh][spec["stairs"] + i] = "S"

    def put_coin(r, c):
        if 0 <= r < ROWS and 0 <= c < cols and g[r][c] == ".":
            g[r][c] = "o"

    for row, a, b in spec["bricks"]:            # platformların üstüne
        for c in range(a, b + 1):
            put_coin(row - 1, c)
    for a, b in spec["gaps"]:                   # uçurumların üstüne
        for c in range(a, b + 1):
            put_coin(8, c)
    for row, a, b in spec.get("extra_coins", []):
        for c in range(a, b + 1):
            put_coin(row, c)

    flag = cols - 4
    for r in range(0, 10):                      # direk tavana kadar (üstünden atlanamaz)
        g[r][flag] = "F"
    return g


