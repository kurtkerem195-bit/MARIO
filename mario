class Sound:
    """Sesler kodla üretilir. Birden çok oynatma motoru vardır; biri çalışmazsa
    Ayarlar'dan değiştirilebilir (Otomatik mod hata olursa kendisi bir sonrakine geçer)."""

    def __init__(self, settings):
        self.settings = settings
        self.error = ""
        self.engines = []
        self.engine = None
        self.files = {}
        self.base = {}
        self.tones = {}
        self.folder = ""
        self.procs = []
        self.last = {}
        self.busy_until = 0.0
        self.busy_prio = -1
        self.mci_open = False
        self.beep_q = None
        self.sync_q = None
        self.pcm = {}
        self.wave_active = []
        self._wv = None
        self._logged = set()
        try:
            self._init()
        except Exception as ex:                    # ses asla oyunu çökertmesin
            self._fail(f"başlatma: {type(ex).__name__}: {ex}")

    # ---- yardımcılar
    @property
    def enabled(self):
        return bool(self.settings["sound"])

    def _fail(self, text):
        self.error = text
        if text not in self._logged:
            self._logged.add(text)
            print("[SES] HATA:", text, file=sys.stderr)

    def _detect(self):
        out = []
        if winsound is not None:
            # MCI uygulamanın kendi ses kanalından çalar; winsound ise Windows'un
            # "Sistem sesleri" kanalından çalar ve o kanal çoğu bilgisayarda kısık/kapalıdır.
            try:
                ctypes.windll.winmm      # noqa: B018  (yalnızca Windows'ta var)
                out += ["waveout", "mci"]
            except Exception:
                pass
            out += ["winsound", "winsync", "beep"]
        elif sys.platform == "darwin":
            if shutil.which("afplay"):
                out.append("afplay")
        else:
            for name in ("paplay", "pw-play", "aplay", "play", "ffplay"):
                if shutil.which(name):
                    out.append(name)
        return out

    def _make_folder(self):
        for cand in (SOUND_DIR, os.path.join(tempfile.gettempdir(), "mini_mario_sesler")):
            try:
                os.makedirs(cand, exist_ok=True)
                probe = os.path.join(cand, ".yaz")
                with open(probe, "w") as f:
                    f.write("1")
                os.remove(probe)
                return cand
            except OSError:
                continue
        return tempfile.mkdtemp(prefix="mini_mario_")

    def _init(self):
        self.engines = self._detect()
        for name, (segs, prio) in SOUND_DEFS.items():
            self.base[name] = build_samples(segs)
            self.tones[name] = build_tones(segs)
        if not self.engines:
            self._fail("ses oynatıcı bulunamadı (Linux'ta aplay / paplay kur)")
            return
        self.folder = self._make_folder()
        self._write_files()
        atexit.register(self._shutdown)
        self.set_engine(self.settings.get("engine", "auto"))
        if self.engine == "mci" and not self.mci_open and self.settings.get("engine", "auto") == "auto":
            alt = [e for e in self.engines if e not in ("mci", "winsync")]
            if alt:                                   # MCI açılamadıysa otomatik yedeğe geç
                self.set_engine(alt[0])
                self.error = ""
        print(f"[SES] motor={self.engine}  klasör={self.folder}")

    def _write_files(self):
        """Ses seviyesine göre WAV dosyalarını (yeniden) yazar."""
        self._mci_close()
        if winsound is not None:
            try:
                winsound.PlaySound(None, winsound.SND_PURGE)
            except Exception:
                pass
        gain = self.settings["volume"] / 100.0 * 2.0
        self.pcm = {}                                  # waveOut tamponları yeni ses seviyesiyle yeniden kurulur
        for name, base in self.base.items():
            path = os.path.join(self.folder, name + ".wav")
            try:
                write_wav(path, base, 1.8 if name == "test_tone" else gain)   # test sesi hep yüksek
            except OSError as ex:
                self._fail(f"dosya yazılamadı ({name}.wav): {ex}")
            self.files[name] = (path, len(base) / RATE, SOUND_DEFS[name][1])
        if self.engine == "mci":
            self._mci_open_all()

    def apply_volume(self):
        if self.folder:
            self._write_files()

    def set_engine(self, choice):
        if not self.engines:
            self.engine = None
            return
        want = choice if choice in self.engines else self.engines[0]
        if self.engine == "mci" and want != "mci":
            self._mci_close()
        self.engine = want
        if want == "mci":
            self._mci_open_all()

    def test_play(self, name):
        """Sihirbaz için: kısıtlamaları atlayıp seçili motorla çalar. Hata metni döner ('' = hata yok)."""
        if self.engine is None or name not in self.files:
            return "motor yok"
        try:
            self._play_with(self.engine, name)
        except Exception as ex:
            self._fail(f"{self.engine}: {type(ex).__name__}: {ex}")
            return f"{type(ex).__name__}: {ex}"
        self.busy_until, self.busy_prio = 0.0, -1
        return ""

    def report(self, results=None):
        import platform
        lines = ["MINI MARIO SES RAPORU",
                 f"sistem: {platform.platform()}",
                 f"python: {sys.version.split()[0]}   tk: {getattr(tk, 'TkVersion', '?')}",
                 f"bulunan motorlar: {self.engines}",
                 f"secili motor: {self.engine}   (ayar: {self.settings.get('engine')})",
                 f"ses acik: {self.enabled}   seviye: {self.settings.get('volume')}",
                 f"klasor: {self.folder}",
                 f"yazilan dosya sayisi: {len(self.files)}",
                 f"son hata: {self.error or '-'}",
                 f"mci acik: {self.mci_open}   waveout acik tampon: {len(self.wave_active)}"]
        if self.files:
            p = next(iter(self.files.values()))[0]
            try:
                lines.append(f"ornek dosya: {p}  ({os.path.getsize(p)} bayt)")
            except OSError as ex:
                lines.append(f"ornek dosya okunamadi: {ex}")
        for k, v in (results or {}).items():
            lines.append(f"test [{k}]: {v}")
        return "\n".join(lines)

    def status(self):
        if not self.engines:
            return False, "ses oynatıcı bulunamadı (Linux'ta aplay / paplay kur)"
        if self.error:
            return False, self.error
        return True, f"hazır, motor: {ENGINE_LABELS.get(self.engine, self.engine)}"

    def _shutdown(self):
        try:
            self._wave_cleanup(force=True)
        except Exception:
            pass
        try:
            self._mci_close()
        except Exception:
            pass

    # ---- MCI (Windows, ctypes)
    def _mci(self, cmd):
        import ctypes
        buf = ctypes.create_unicode_buffer(256)
        err = ctypes.windll.winmm.mciSendStringW(cmd, buf, 255, 0)
        if err:
            eb = ctypes.create_unicode_buffer(256)
            ctypes.windll.winmm.mciGetErrorStringW(err, eb, 255)
            raise RuntimeError(f"MCI {err}: {eb.value}")
        return buf.value

    def _mci_open_all(self):
        # "waveaudio" aygıtı bazı Windows kurulumlarında kayıtlı değildir (MCI 263);
        # o yüzden türü belirtmeden ve başka türlerle de dene.
        forms = ['open "{p}" type waveaudio alias mm_{n}', 'open "{p}" alias mm_{n}',
                 'open "{p}" type mpegvideo alias mm_{n}']
        try:
            first_err = None
            for name, (path, _, _) in self.files.items():
                done = False
                for form in list(forms):
                    try:
                        self._mci(form.format(p=path, n=name))
                        forms = [form]                  # çalışan biçimi sonrakilerde kullan
                        done = True
                        break
                    except Exception as ex:
                        first_err = first_err or ex
                if not done:
                    raise first_err
            self.mci_open = True
        except Exception as ex:
            self._fail(f"MCI açılamadı: {ex}")

    def _mci_close(self):
        if not self.mci_open:
            return
        self.mci_open = False
        try:
            self._mci("close all")
        except Exception:
            pass

    # ---- waveOut (Windows, ctypes): MCI / winsound kayıtları bozuk olsa da çalışır
    def _wave_setup(self):
        c = ctypes
        w = c.windll.winmm
        w.waveOutOpen.argtypes = [c.POINTER(c.c_void_p), c.c_uint, c.POINTER(WAVEFORMATEX),
                                  c.c_size_t, c.c_size_t, c.c_uint]
        for fn in ("waveOutPrepareHeader", "waveOutWrite", "waveOutUnprepareHeader"):
            getattr(w, fn).argtypes = [c.c_void_p, c.POINTER(WAVEHDR), c.c_uint]
            getattr(w, fn).restype = c.c_uint
        w.waveOutOpen.restype = c.c_uint
        w.waveOutReset.argtypes = [c.c_void_p]
        w.waveOutReset.restype = c.c_uint
        w.waveOutClose.argtypes = [c.c_void_p]
        w.waveOutClose.restype = c.c_uint
        self._wv = w

    def _wave_err(self, code, what):
        try:
            buf = ctypes.create_unicode_buffer(256)
            self._wv.waveOutGetErrorTextW(code, buf, 255)
            return f"{what} hata {code}: {buf.value}"
        except Exception:
            return f"{what} hata {code}"

    def _wave_cleanup(self, force=False):
        if self._wv is None:
            return
        w, keep = self._wv, []
        for handle, hdr, buf in self.wave_active:
            if force or (hdr.dwFlags & WHDR_DONE):
                if force:
                    w.waveOutReset(handle)
                w.waveOutUnprepareHeader(handle, ctypes.byref(hdr), ctypes.sizeof(hdr))
                w.waveOutClose(handle)
            else:
                keep.append((handle, hdr, buf))
        self.wave_active = keep

    def _wave_play(self, name):
        if self._wv is None:
            self._wave_setup()
        w = self._wv
        self._wave_cleanup()
        if len(self.wave_active) >= 24:
            return
        pcm = self.pcm.get(name)
        if pcm is None:
            gain = 1.8 if name == "test_tone" else self.settings["volume"] / 100.0 * 2.0
            data = array.array("h", (int(max(-0.98, min(0.98, v * gain)) * 32767)
                                     for v in self.base[name]))
            if sys.byteorder == "big":
                data.byteswap()
            pcm = self.pcm[name] = data.tobytes()
        buf = ctypes.create_string_buffer(pcm, len(pcm))
        fmt = WAVEFORMATEX(1, 1, RATE, RATE * 2, 2, 16, 0)       # PCM, mono, 16 bit
        handle = ctypes.c_void_p()
        r = w.waveOutOpen(ctypes.byref(handle), WAVE_MAPPER, ctypes.byref(fmt), 0, 0, 0)
        if r:
            raise RuntimeError(self._wave_err(r, "waveOutOpen"))
        hdr = WAVEHDR()
        hdr.lpData = ctypes.addressof(buf)
        hdr.dwBufferLength = len(pcm)
        size = ctypes.sizeof(hdr)
        r = w.waveOutPrepareHeader(handle, ctypes.byref(hdr), size)
        if r:
            w.waveOutClose(handle)
            raise RuntimeError(self._wave_err(r, "waveOutPrepareHeader"))
        r = w.waveOutWrite(handle, ctypes.byref(hdr), size)
        if r:
            w.waveOutUnprepareHeader(handle, ctypes.byref(hdr), size)
            w.waveOutClose(handle)
            raise RuntimeError(self._wave_err(r, "waveOutWrite"))
        self.wave_active.append((handle, hdr, buf))

    # ---- winsound, ayrı iş parçacığında (eşzamanlı çalma)
    def _sync_worker(self):
        while True:
            path = self.sync_q.get()
            try:
                winsound.PlaySound(path, winsound.SND_FILENAME)
            except Exception as ex:
                self._fail(f"winsync hatası: {ex}")

    # ---- Bip (Windows, son çare)
    def _beep_worker(self):
        while True:
            tones = self.beep_q.get()
            for f, ms in tones:
                try:
                    if f:
                        winsound.Beep(int(f), int(ms))
                    else:
                        time.sleep(ms / 1000.0)
                except Exception as ex:
                    self._fail(f"Bip hatası: {ex}")
                    break

    # ---- çalma
    def play(self, name):
        if not self.enabled or self.engine is None or name not in self.files:
            return
        now = time.monotonic()
        if now - self.last.get(name, 0.0) < 0.04:
            return
        prio = self.files[name][2]
        if self.engine in ("winsound", "beep") and now < self.busy_until and prio < self.busy_prio:
            return
        try:
            self._play_with(self.engine, name)
        except Exception as ex:
            self._fail(f"{self.engine}: {type(ex).__name__}: {ex}")
            if self.settings.get("engine", "auto") == "auto":
                i = self.engines.index(self.engine) if self.engine in self.engines else -1
                for cand in [e for e in self.engines[i + 1:] if e != "winsync"]:   # winsync aynı çağrıyı kullanır
                    self.set_engine(cand)                 # otomatik: çalışan bir motor bulana kadar sırayla dene
                    if cand == "mci" and not self.mci_open:
                        continue
                    self.error = ""
                    try:
                        self._play_with(cand, name)
                        break
                    except Exception as ex2:
                        self._fail(f"{cand}: {type(ex2).__name__}: {ex2}")
            return
        self.last[name] = now

    def _play_with(self, engine, name):
        path, dur, prio = self.files[name]
        now = time.monotonic()
        if engine == "winsound":
            winsound.PlaySound(path, winsound.SND_FILENAME | winsound.SND_ASYNC)
            self.busy_until, self.busy_prio = now + dur, prio
        elif engine == "waveout":
            self._wave_play(name)
        elif engine == "winsync":
            if self.sync_q is None:
                self.sync_q = queue.Queue()
                threading.Thread(target=self._sync_worker, daemon=True).start()
            if self.sync_q.qsize() < 3:
                self.sync_q.put(path)
        elif engine == "mci":
            self._mci(f"play mm_{name} from 0")
        elif engine == "beep":
            if self.beep_q is None:
                self.beep_q = queue.Queue()
                threading.Thread(target=self._beep_worker, daemon=True).start()
            if self.beep_q.qsize() < 3:
                self.beep_q.put(self.tones[name])
                self.busy_until = now + sum(ms for _, ms in self.tones[name]) / 1000.0
                self.busy_prio = prio
        else:
            self.procs = [p for p in self.procs if p.poll() is None]
            if len(self.procs) > 8:
                return
            self.procs.append(subprocess.Popen(
                CMDS[engine] + [path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))


# ================================================================ GRAFİK (piksel dokular)
def _rgb(c):
    return int(c[1:3], 16), int(c[3:5], 16), int(c[5:7], 16)


def _hex(r, g, b):
    return "#%02x%02x%02x" % (max(0, min(255, int(r))), max(0, min(255, int(g))),
                              max(0, min(255, int(b))))


def shade(c, f):
    """f>0: beyaza doğru aç, f<0: siyaha doğru koyulaştır."""
    r, g, b = _rgb(c)
    if f >= 0:
        return _hex(r + (255 - r) * f, g + (255 - g) * f, b + (255 - b) * f)
    return _hex(r * (1 + f), g * (1 + f), b * (1 + f))


def mix(c1, c2, t):
    a, b = _rgb(c1), _rgb(c2)
    return _hex(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t)


class Pix:
    """Küçük piksel tuvali. None = saydam."""
    def __init__(self, w=TILE, h=TILE):
        self.w, self.h = w, h
        self.px = [[None] * w for _ in range(h)]

    def set(self, x, y, col):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.px[y][x] = col

    def rect(self, x1, y1, x2, y2, col):
        for y in range(max(0, y1), min(self.h, y2)):
            row = self.px[y]
            for x in range(max(0, x1), min(self.w, x2)):
                row[x] = col

    def to_image(self, fallback):
        img = tk.PhotoImage(width=self.w, height=self.h)
        holes = []
        rows = []
        for y in range(self.h):
            cells = []
            for x in range(self.w):
                v = self.px[y][x]
                if v is None:
                    holes.append((x, y))
                    v = fallback
                cells.append(v)
            rows.append("{" + " ".join(cells) + "}")
        img.put(" ".join(rows))
        for x, y in holes:
            try:
                img.transparency_set(x, y, True)
            except (AttributeError, tk.TclError):
                break
        return img


