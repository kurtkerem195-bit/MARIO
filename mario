def default_eq(idx):
    return {"hat": "red" if idx == 0 else "green", "overall": "blue",
            "boots": "brown", "acc": []}


def resolve_look(eq):
    return {"hat": HAT_COLORS[eq["hat"]],
            "overall": OVERALL_COLORS[eq["overall"]],
            "boots": BOOT_COLORS[eq["boots"]],
            "acc": list(eq["acc"])}


# ---------------------------------------------------------------- Kayıt
def _clean_eq(raw, idx):
    eq = default_eq(idx)
    if isinstance(raw, dict):
        if raw.get("hat") in HAT_COLORS:
            eq["hat"] = raw["hat"]
        if raw.get("overall") in OVERALL_COLORS:
            eq["overall"] = raw["overall"]
        if raw.get("boots") in BOOT_COLORS:
            eq["boots"] = raw["boots"]
        acc = raw.get("acc", [])
        if isinstance(acc, str):            # eski kayıt biçimi
            acc = [] if acc == "none" else [acc]
        if isinstance(acc, list):
            eq["acc"] = [a for a in acc if a in ACC_IDS][:MAX_ACC]
    return eq


def load_save():
    data = {"xp": 0, "owned": list(DEFAULT_OWNED),
            "equipped": default_eq(0), "equipped2": default_eq(1),
            "settings": dict(DEFAULT_SETTINGS)}
    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            loaded = json.load(f)
        if not isinstance(loaded, dict):
            raise ValueError
        if isinstance(loaded.get("xp"), int):
            data["xp"] = loaded["xp"]
        if isinstance(loaded.get("owned"), list):
            data["owned"] = [str(o) for o in loaded["owned"]]
        data["equipped"] = _clean_eq(loaded.get("equipped"), 0)
        data["equipped2"] = _clean_eq(loaded.get("equipped2"), 1)
        st = loaded.get("settings")
        if isinstance(st, dict):
            if isinstance(st.get("sound"), bool):
                data["settings"]["sound"] = st["sound"]
            if isinstance(st.get("volume"), int):
                data["settings"]["volume"] = max(0, min(100, st["volume"]))
            if isinstance(st.get("engine"), str):
                data["settings"]["engine"] = st["engine"]
            if st.get("difficulty") in (0, 1, 2):
                data["settings"]["difficulty"] = st["difficulty"]
            if st.get("players") in (1, 2):
                data["settings"]["players"] = st["players"]
            if isinstance(st.get("sound_ok"), bool):
                data["settings"]["sound_ok"] = st["sound_ok"]
            if isinstance(st.get("fullscreen"), bool):
                data["settings"]["fullscreen"] = st["fullscreen"]
            if isinstance(st.get("fs_crisp"), bool):
                data["settings"]["fs_crisp"] = st["fs_crisp"]
            if st.get("audio_v") != AUDIO_VERSION:      # eski ses seçimini sıfırla (otomatik + yeniden sihirbaz)
                data["settings"]["engine"] = "auto"
                data["settings"]["sound_ok"] = False
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    for o in DEFAULT_OWNED:
        if o not in data["owned"]:
            data["owned"].append(o)
    data["settings"]["audio_v"] = AUDIO_VERSION
    return data


# ================================================================ SES
RATE = 22050


def _synth(f0, f1, dur, vol=0.4, wave_type="square", vib=0.0, vib_hz=0.0, seed=1):
    rng = random.Random(seed)
    n = max(1, int(RATE * dur))
    out = []
    phase = 0.0
    for i in range(n):
        t = i / n
        f = f0 + (f1 - f0) * t
        if vib:
            f *= 1 + vib * math.sin(2 * math.pi * vib_hz * i / RATE)
        phase = (phase + f / RATE) % 1.0
        if wave_type == "square":
            s = 1.0 if phase < 0.5 else -1.0
        elif wave_type == "pulse":
            s = 1.0 if phase < 0.25 else -1.0
        elif wave_type == "tri":
            s = 4 * abs(phase - 0.5) - 1
        elif wave_type == "saw":
            s = 2 * phase - 1
        elif wave_type == "noise":
            s = rng.uniform(-1, 1)
        else:
            s = math.sin(2 * math.pi * phase)
        env = min(1.0, i / (RATE * 0.004)) * (1 - t) ** 0.8
        out.append(s * vol * env)
    return out


def _mix(*tracks):
    n = max(len(t) for t in tracks)
    out = [0.0] * n
    for t in tracks:
        for i, v in enumerate(t):
            out[i] += v
    return out


def V(f0, f1, dur, vol=0.4, wave_type="square", vib=0.0, vib_hz=0.0):
    """Tek ses 'sesi': (başlangıç Hz, bitiş Hz, süre sn, ses, dalga, titreşim, titreşim Hz)."""
    return (f0, f1, dur, vol, wave_type, vib, vib_hz)


def SIL(dur):
    return V(100, 100, dur, 0.0)


