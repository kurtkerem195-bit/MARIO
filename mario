SCALES = [(n, 4) for n in range(4, 25)]            # 1.0, 1.25, 1.5 ... 6.0 (blok boyu hep tam piksel)
SCALES_CRISP = [(n, 4) for n in range(4, 25, 4)]  # sadece tam sayı katları: en keskin görüntü


class View:
    """Çizimi mantıksal 800x480 koordinatlarından gerçek pencereye ölçekler (tam ekran için).
    Ölçek hep 40 pikselin tam katı bir blok boyu verir (1, 1.25, 1.5 ... 4), ortalanır ve
    kalan yerler siyah kalır."""

    def __init__(self, cv):
        self.cv = cv
        self.p, self.q = 1, 1
        self.ox = self.oy = 0.0
        self.win = (W, H)
        self.imgs = {}

    @property
    def f(self):
        return self.p / self.q

    def fit(self, w, h, crisp=False):
        fit = min(w / W, h / H)
        best = (4, 4)
        for p, q in (SCALES_CRISP if crisp else SCALES):
            if p / q <= fit + 1e-9:
                best = (p, q)
        g = math.gcd(best[0], best[1])
        best = (best[0] // g, best[1] // g)
        if best != (self.p, self.q):
            self.imgs = {}
        self.p, self.q = best
        self.win = (w, h)
        self.ox, self.oy = (w - W * self.f) / 2, (h - H * self.f) / 2

    def letterbox(self):
        """Oyun alanının dışına taşan her şeyi siyah bantlarla örter (tam ekranda bozulmayı önler)."""
        w, h = self.win
        x1, y1 = round(self.ox), round(self.oy)
        x2, y2 = round(self.ox + W * self.f), round(self.oy + H * self.f)
        cv = self.cv
        if x1 > 0:
            cv.create_rectangle(0, 0, x1, h, fill="black", outline="")
        if x2 < w:
            cv.create_rectangle(x2, 0, w, h, fill="black", outline="")
        if y1 > 0:
            cv.create_rectangle(x1, 0, x2, y1, fill="black", outline="")
        if y2 < h:
            cv.create_rectangle(x1, y2, x2, h, fill="black", outline="")

    def _x(self, x):
        return self.ox + x * self.f

    def _y(self, y):
        return self.oy + y * self.f

    def _pts(self, pts):
        return [self._x(v) if i % 2 == 0 else self._y(v) for i, v in enumerate(pts)]

    def _kw(self, kw):
        if self.f != 1:
            if "width" in kw:
                kw["width"] = max(1, round(kw["width"] * self.f))
            if "font" in kw:
                fam, size, *rest = kw["font"]
                kw["font"] = (fam, max(6, round(size * self.f)), *rest)
        return kw

    def _scaled(self, img):
        if self.f == 1:
            return img
        key = (id(img), self.p, self.q)
        hit = self.imgs.get(key)
        if hit is None:
            big = img.zoom(self.p)
            hit = (big.subsample(self.q) if self.q > 1 else big, img)
            self.imgs[key] = hit
        return hit[0]

    def delete(self, *a):
        return self.cv.delete(*a)

    def create_rectangle(self, x1, y1, x2, y2, **kw):
        return self.cv.create_rectangle(self._x(x1), self._y(y1), self._x(x2), self._y(y2), **self._kw(kw))

    def create_oval(self, x1, y1, x2, y2, **kw):
        return self.cv.create_oval(self._x(x1), self._y(y1), self._x(x2), self._y(y2), **self._kw(kw))

    def create_arc(self, x1, y1, x2, y2, **kw):
        return self.cv.create_arc(self._x(x1), self._y(y1), self._x(x2), self._y(y2), **self._kw(kw))

    def create_polygon(self, *pts, **kw):
        return self.cv.create_polygon(*self._pts(pts), **self._kw(kw))

    def create_line(self, *pts, **kw):
        return self.cv.create_line(*self._pts(pts), **self._kw(kw))

    def create_text(self, x, y, **kw):
        return self.cv.create_text(self._x(x), self._y(y), **self._kw(kw))

    def create_image(self, x, y, image=None, anchor="nw", **kw):
        return self.cv.create_image(self._x(x), self._y(y), image=self._scaled(image), anchor=anchor)


