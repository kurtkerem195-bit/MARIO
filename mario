    # ---- dükkan
    def equipped_of(self, idx):
        return self.save["equipped"] if idx == 0 else self.save["equipped2"]

    def load_shop_cols(self):
        eq = self.equipped_of(self.shop_player)
        self.shop_col[0] = [o[0] for o in HATS].index(eq["hat"])
        self.shop_col[1] = [o[0] for o in OVERALLS].index(eq["overall"])
        self.shop_col[2] = [o[0] for o in BOOTS].index(eq["boots"])
        self.shop_col[3] = ACC_IDS.index(eq["acc"][0]) if eq["acc"] else 0

    def open_shop(self, came_from):
        self.shop_from = came_from
        self.load_shop_cols()
        self.shop_msg = ""
        self.state = "shop"

    def shop_action(self):
        key, _, opts = CATS[self.shop_row]
        oid, name, _, cost = opts[self.shop_col[self.shop_row]]
        full = f"{key}:{oid}"
        bought = False
        if full not in self.save["owned"]:
            if self.save["xp"] < cost:
                self.shop_msg = f"Yeterli XP yok! ({cost - self.save['xp']} XP eksik)"
                self.shop_msg_t = 120
                self.snd.play("error")
                return
            self.save["xp"] -= cost
            self.save["owned"].append(full)
            bought = True
        eq = self.equipped_of(self.shop_player)
        if key == "acc":
            accs = eq["acc"]
            if oid in accs and not bought:
                accs.remove(oid)
                self.shop_msg = f"{name} çıkarıldı."
            else:
                if oid not in accs:
                    accs.append(oid)
                self.shop_msg = f"{name} satın alındı ve takıldı!" if bought else f"{name} takıldı."
                if len(accs) > MAX_ACC:
                    dropped = accs.pop(0)
                    dn = next(o[1] for o in ACCS if o[0] == dropped)
                    self.shop_msg += f" ({dn} çıkarıldı, en fazla {MAX_ACC})"
        else:
            eq[key] = oid
            self.shop_msg = f"{name} satın alındı!" if bought else f"{name} seçildi."
        self.shop_msg_t = 120
        self.snd.play("buy" if bought else "equip")
        self.write_save()

    # ---- fizik
    def solid(self, c, r):
        if c < 0 or c >= self.cols:
            return True
        if r < 0 or r >= ROWS:
            return False
        return self.grid[r][c] in SOLID

    def free(self, x, y, w, h):
        for r in range(int(y // TILE), int((y + h - 1) // TILE) + 1):
            for c in range(int(x // TILE), int((x + w - 1) // TILE) + 1):
                if self.solid(c, r):
                    return False
        return True

    def move_x(self, e):
        e.x += e.vx
        hit = False
        top, bot = int(e.y // TILE), int((e.y + e.h - 1) // TILE)
        left, right = int(e.x // TILE), int((e.x + e.w - 1) // TILE)
        for r in range(top, bot + 1):
            for c in range(left, right + 1):
                if self.solid(c, r):
                    if e.vx > 0:
                        e.x = c * TILE - e.w
                    elif e.vx < 0:
                        e.x = (c + 1) * TILE
                    hit = True
        return hit

    def nudge(self, e, c, r):
        """Kafa bloğun köşesine hafif takılırsa yana kaydır (köşe affı)."""
        bl, br = c * TILE, (c + 1) * TILE
        over_r = e.x + e.w - bl
        over_l = br - e.x
        if 0 < over_r <= 10 and self.free(bl - e.w, e.y, e.w, e.h):
            e.x = bl - e.w
            return True
        if 0 < over_l <= 10 and self.free(br, e.y, e.w, e.h):
            e.x = br
            return True
        return False

    def move_y(self, e, is_player=False):
        e.y += e.vy
        e.on_ground = False
        top, bot = int(e.y // TILE), int((e.y + e.h - 1) // TILE)
        left, right = int(e.x // TILE), int((e.x + e.w - 1) // TILE)
        for r in range(top, bot + 1):
            for c in range(left, right + 1):
                if self.solid(c, r):
                    if e.vy > 0:
                        e.y = r * TILE - e.h
                        e.on_ground = True
                    elif e.vy < 0:
                        if is_player and self.nudge(e, c, r):
                            continue
                        e.y = (r + 1) * TILE
                        if is_player:
                            self.bump(c, r)
                    e.vy = 0
        if not e.on_ground and e.vy >= 0:
            # yerdeyken 1 pikselden az gömülme "havada" sayılmasın (zemin titremesini önler)
            fr = int((e.y + e.h) // TILE)
            if (e.y + e.h) - fr * TILE < 1.5 and any(
                    self.solid(cc, fr) for cc in range(left, right + 1)):
                e.y = fr * TILE - e.h
                e.on_ground = True
                e.vy = 0

    def bump(self, c, r):
        """Oyuncu bloğa kafayı vurdu."""
        ch = self.grid[r][c]
        if ch == "?":
            self.grid[r][c] = "U"
            xp = int(random.randint(15, 45) * self.diff["xp"])
            self.save["xp"] += xp
            self.write_save()
            self.bumped[(c, r)] = BUMP_FRAMES
            self.popups.append([f"+{xp} XP", c * TILE + TILE / 2, r * TILE - 8, 55, "#7df9ff"])
            self.snd.play("xp")
        elif ch == "B":
            self.bumped[(c, r)] = BUMP_FRAMES
            self.snd.play("brick")
        elif ch == "U":
            self.bumped[(c, r)] = BUMP_FRAMES
            self.snd.play("bump")

    def puff(self, x, y, n):
        for _ in range(n):
            self.particles.append([x + random.uniform(-6, 6), y - 2,
                                   random.uniform(-1.2, 1.2), random.uniform(-1.0, -0.2), 18])

    def tiles_touching(self, e):
        for r in range(int(e.y // TILE), int((e.y + e.h - 1) // TILE) + 1):
            for c in range(int(e.x // TILE), int((e.x + e.w - 1) // TILE) + 1):
                if 0 <= r < ROWS and 0 <= c < self.cols:
                    yield c, r

    def visible(self, e):
        x = e.cx if e.kind == "plant" else e.x
        return self.cam - 40 < x < self.cam + W + 40

    # ---- güncelleme
    def update(self):
        self.frame += 1
        for pop in self.popups:
            pop[2] -= 0.8
            pop[3] -= 1
        self.popups = [p for p in self.popups if p[3] > 0]
        for pt in self.particles:
            pt[0] += pt[2]
            pt[1] += pt[3]
            pt[4] -= 1
        self.particles = [p for p in self.particles if p[4] > 0]
        for k in list(self.bumped):
            self.bumped[k] -= 1
            if self.bumped[k] <= 0:
                del self.bumped[k]
        if self.shop_msg_t > 0:
            self.shop_msg_t -= 1
        if self.toast_t > 0:
            self.toast_t -= 1
        if self.state != "play":
            return
        for pl in self.players:
            self.update_player(pl)
            if self.state != "play":
                return
        self.enforce_separation()
        self.update_enemies()
        self.update_camera()

    def update_player(self, pl):
        if pl.out:
            return
        if pl.dead_t > 0:
            pl.dead_t -= 1
            if pl.dead_t == 0:
                self.spawn(pl)
                if len(self.players) == 1:
                    self.look = 0.0
                    self.snap_camera()
            return
        if pl.invuln > 0:
            pl.invuln -= 1

        km = pl.keymap
        left = bool(self.keys & km["left"])
        right = bool(self.keys & km["right"])
        run = bool(self.keys & km["run"])
        pl.jump_held = bool(self.keys & km["jump"])

        # --- yatay hareket: ivmelenme + sürtünme + koşma
        dirx = (1 if right else 0) - (1 if left else 0)
        maxv = RUN if run else WALK
        if dirx:
            acc = ACCEL if pl.on_ground else AIR_ACCEL
            if pl.vx * dirx < 0:                # ters yöne dönüş: frenle
                acc *= 2.2
            target = dirx * maxv
            if pl.vx < target:
                pl.vx = min(pl.vx + acc, target)
            elif pl.vx > target:
                pl.vx = max(pl.vx - acc, target)
            pl.face = dirx
        else:
            fr = FRICTION if pl.on_ground else AIR_FRICTION
            if abs(pl.vx) <= fr:
                pl.vx = 0.0
            else:
                pl.vx -= fr if pl.vx > 0 else -fr

        # --- zıplama: coyote süresi + tuş hafızası + değişken yükseklik + çift zıplama
        if pl.on_ground:
            pl.coyote = COYOTE
            pl.air_jumps = MAX_AIR_JUMPS
        elif pl.coyote > 0:
            pl.coyote -= 1
        if pl.jump_buf > 0:
            pl.jump_buf -= 1
        if pl.jump_buf > 0 and pl.coyote > 0:
            pl.vy = JUMP - min(abs(pl.vx), RUN) * 0.12    # koşarak zıplayınca biraz daha yüksek
            pl.on_ground = False
            pl.coyote = 0
            pl.jump_buf = 0
            self.snd.play("jump")
            self.puff(pl.x + pl.w / 2, pl.y + pl.h, 3)
        elif pl.jump_buf > 0 and pl.coyote <= 0 and pl.air_jumps > 0:
            pl.vy = DOUBLE_JUMP
            pl.air_jumps -= 1
            pl.jump_buf = 0
            self.snd.play("double_jump")
            self.puff(pl.x + pl.w / 2, pl.y + pl.h, 6)
        if not pl.jump_held and pl.vy < -5:               # tuşu bırakınca kısa zıpla
            pl.vy = -5

        pl.vy = min(pl.vy + (GRAVITY if pl.vy < 0 else FALL_GRAVITY), MAX_FALL)
        fall_speed = pl.vy
        was_ground = pl.on_ground
        if self.move_x(pl):
            pl.vx = 0.0
        self.move_y(pl, True)
        if pl.on_ground and not was_ground and fall_speed > 6:
            self.puff(pl.x + pl.w / 2, pl.y + pl.h, 4)
        if pl.on_ground and abs(pl.vx) > 5 and self.frame % 7 == 0:
            self.puff(pl.x + pl.w / 2 - pl.face * 8, pl.y + pl.h, 1)

        # --- altın ve bayrak
        reached_flag = pl.x + pl.w / 2 > (self.cols - 4) * TILE + 20     # direği geçti
        for c, r in self.tiles_touching(pl):
            ch = self.grid[r][c]
            if ch == "F":
                reached_flag = True
            if ch == "o":
                self.grid[r][c] = "."
                pl.coins += 1
                pl.score += 100
                self.snd.play("coin")

        if reached_flag:
            for q in self.players:
                if not q.out:
                    q.score += q.lives * 500
            self.write_save()
            self.state = "levelwin"
            self.snd.play("win")
            return

        # --- kontrol noktası ve güvenli konum
        for col in self.checks:
            px = col * TILE + 6
            if pl.x > col * TILE and (self.checkpoint is None or px > self.checkpoint):
                self.checkpoint = px
                self.say("Kontrol noktası!", 80)
                self.snd.play("checkpoint")
        if pl.on_ground:
            rr = int((pl.y + pl.h) // TILE)
            if (self.solid(int((pl.x + 2) // TILE), rr)
                    and self.solid(int((pl.x + pl.w - 3) // TILE), rr)):
                pl.safe_x, pl.safe_y = pl.x, pl.y

        # --- uçuruma / lava'ya düştü
        if pl.y > H + 60:
            self.kill_player(pl)

    def enforce_separation(self):
        """2 oyuncu: ileri giden, gerideki oyuncudan çok uzaklaşamaz (ikisi de ekranda kalır)."""
        al = self.alive_players()
        if len(al) == 2:
            a, b = sorted(al, key=lambda q: q.x)
            if b.x - a.x > MAX_SEP:
                b.x = a.x + MAX_SEP
                if b.vx > 0:
                    b.vx = 0.0

    def kill_player(self, pl, by=None):
        if pl.out or pl.dead_t > 0:
            return
        pl.lives -= 1
        pl.vx = pl.vy = 0.0
        if pl.lives <= 0:
            pl.out = True
        else:
            pl.dead_t = 70
        if all(p.out for p in self.players):
            self.state = "over"
            self.snd.play("over")
        else:
            snd = DIE_SOUNDS.get(by, "die") if by else "die"
            if snd:
                self.snd.play(snd)
            if len(self.players) > 1:
                self.say(f"Oyuncu {pl.idx + 1} öldü!" if not pl.out
                         else f"Oyuncu {pl.idx + 1} elendi!", 70)

    def enemy_rect(self, e):
        k = e.kind
        if k == "plant":
            if e.ext <= 6:
                return None
            return (e.cx - 16, e.top - e.ext + 3, 32, e.ext)
        if k == "lavaball":
            return (e.x, e.y, e.w, e.h) if (e.state == "fly" and e.y < H) else None
        return (e.x, e.y, e.w, e.h)

    def update_enemies(self):
        al = self.alive_players()
        for e in self.enemies:
            if not e.alive:
                if e.squash > 0:
                    e.squash -= 1
                continue
            if not al:
                continue
            ex = e.cx if e.kind == "plant" else e.x
            target = min(al, key=lambda p: abs(p.x - ex))
            if abs(ex - target.x) > W:          # uzaktakiler uyur
                continue
            self.update_enemy(e, target, al)
            if not e.alive:
                continue
            r = self.enemy_rect(e)
            if r is None:
                continue
            for pl in al:
                if pl.dead_t > 0 or pl.out:
                    continue
                if hit_rect(pl, r):
                    stomp = (e.kind not in UNSTOMPABLE and pl.vy > 0
                             and (pl.y + pl.h - r[1]) < 24)
                    if stomp:                   # üstüne bastı
                        e.alive = False
                        e.squash = 30
                        pl.vy = -11 if pl.jump_held else -8
                        pl.score += 200
                        pl.air_jumps = MAX_AIR_JUMPS
                        self.snd.play("stomp_" + e.kind)
                        self.puff(e.x + e.w / 2, e.y + e.h, 3)
                        break
                    elif pl.invuln == 0:
                        self.kill_player(pl, e.kind)
        self.enemies = [e for e in self.enemies if e.alive or e.squash > 0]

    def update_enemy(self, e, target, al):
        k = e.kind
        if k == "flyer":
            e.x += e.dir * e.speed
            e.phase += 0.06
            e.y = e.base_y + math.sin(e.phase) * 40
            if e.x - e.start_x > 120:
                e.dir = -1
            elif e.x - e.start_x < -120:
                e.dir = 1
        elif k == "ghost":
            self.update_ghost(e, target)
        elif k == "lavaball":
            self.update_lava(e)
        elif k == "plant":
            self.update_plant(e, al)
        else:
            self.update_walker(e, target, al)

    def update_ghost(self, e, target):
        """Utangaç hayalet: bakınca donar, arkanı dönünce üstüne süzülür."""
        ex, px = e.x + e.w / 2, target.x + target.w / 2
        facing = (ex - px) * target.face > 0       # oyuncu hayalete bakıyor
        if e.boo_cd > 0:
            e.boo_cd -= 1
        if facing:
            e.chasing = False
        else:
            if not e.chasing and e.boo_cd == 0 and self.visible(e):
                self.snd.play("ghost_boo")
                e.boo_cd = 240
            e.chasing = True
        if e.chasing:
            dx = px - ex
            dy = (target.y + target.h / 2) - (e.y + e.h / 2)
            dist = max(1.0, math.hypot(dx, dy))
            e.x += dx / dist * e.speed
            e.y += dy / dist * e.speed * 0.7
            e.y = max(40, min(380, e.y))

    def update_lava(self, e):
        if e.state == "wait":
            e.t -= 1
            if e.t <= 0:
                e.state = "fly"
                e.vy = -(15.5 + random.random() * 2.5)
                e.y = H + 10
                if self.visible(e):
                    self.snd.play("lava_pop")
        else:
            e.vy += 0.45
            e.y += e.vy
            if e.y > H + 30 and e.vy > 0:
                e.state = "wait"
                e.t = random.randint(50, 130)

    def update_plant(self, e, al):
        """Borudan çıkan etobur bitki: yanında biri varsa çıkmaz."""
        near = any(abs(p.x + p.w / 2 - e.cx) < 60 and p.y + p.h > e.top - 70 for p in al)
        cycle = 230
        if not ((e.t % cycle) < 100 and near):
            e.t += 1
        ph = e.t % cycle
        if ph < 100:
            e.ext = 0
        elif ph < 120:
            e.ext = 52 * (ph - 100) / 20
        elif ph < 190:
            e.ext = 52
        elif ph < 210:
            e.ext = 52 * (1 - (ph - 190) / 20)
        else:
            e.ext = 0
        if ph == 100 and self.visible(e):
            self.snd.play("plant_chomp")

    def update_walker(self, e, target, al):
        k = e.kind
        s = e.speed
        if k == "penguin":
            if e.dash > 0:
                e.dash -= 1
                s = e.speed * 3.2
            elif e.cool > 0:
                e.cool -= 1
            elif e.on_ground and abs(target.x - e.x) < 240 and abs(target.y - e.y) < 50:
                e.dir = 1 if target.x > e.x else -1
                e.dash = 40
                e.cool = 150
                if self.visible(e):
                    self.snd.play("penguin_dash")
        elif k == "bomb":
            if e.state == "walk":
                if e.on_ground and any(abs(p.x - e.x) < 100 and abs(p.y - e.y) < 70 for p in al):
                    e.state = "lit"
                    e.fuse = 70
                    if self.visible(e):
                        self.snd.play("bomb_fuse")
            else:
                s = 0.0
                e.fuse -= 1
                if e.fuse <= 0:
                    self.explode(e)
                    return
        e.vx = e.dir * s
        e.vy = min(e.vy + GRAVITY, MAX_FALL)
        if self.move_x(e):
            e.dir = -e.dir
        self.move_y(e)
        if k == "hopper" and e.on_ground:
            e.timer -= 1
            if e.timer <= 0:
                e.vy = -11
                e.timer = random.randint(50, 90)
        if e.on_ground and s > 0 and not (k == "penguin" and e.dash > 0):
            ahead = e.x + (e.w + 1 if e.dir > 0 else -1)
            if not self.solid(int(ahead // TILE), int((e.y + e.h + 1) // TILE)):
                e.dir = -e.dir                  # uçurumdan dönsün
        if e.y > H + 100:
            e.alive = False

    def explode(self, e):
        e.alive = False
        e.exploded = True
        e.squash = 24
        if self.visible(e):
            self.snd.play("bomb_boom")
        cx, cy = e.x + e.w / 2, e.y + e.h / 2
        for pl in self.players:
            if pl.out or pl.dead_t > 0 or pl.invuln > 0:
                continue
            if math.hypot(pl.x + pl.w / 2 - cx, pl.y + pl.h / 2 - cy) < 78:
                self.kill_player(pl, "bomb")

    def update_camera(self):
        al = [p for p in self.players if not p.out]
        if not al:
            return
        if len(self.players) == 1:
            p = al[0]
            self.look += (p.face * 70 * (1 if abs(p.vx) > 0.5 else 0.4) - self.look) * 0.05
            target = p.x - W * 0.4 + self.look
        else:
            live = [p for p in al if p.dead_t == 0] or al
            target = sum(p.x for p in live) / len(live) + 14 - W / 2
        self.cam += (target - self.cam) * 0.15
        self.cam = max(0, min(self.cols * TILE - W, self.cam))

    # ---- dokular
    def get_tile(self, ch, row, col):
        """(PhotoImage, y_kayması) döner. Dokular önbelleğe alınır."""
        th, tkey = self.theme, self.spec["theme"]
        if ch == "#":
            lo = not self.solid(col - 1, row)
            ro = not self.solid(col + 1, row)
            grass = row == 10 and not self.solid(col, row - 1)
            var = (col + row) % 3
            key = ("g" if grass else "d", tkey, var, lo, ro)
            if key not in self.tiles:
                self.tiles[key] = make_ground_tile(th, var, grass, lo, ro).to_image(th["sky"])
            return self.tiles[key], (-GRASS_PAD if grass else 0)
        if ch == "B":
            key = ("B", tkey)
            if key not in self.tiles:
                self.tiles[key] = make_brick_tile(th).to_image(th["sky"])
        elif ch == "S":
            key = ("S", tkey)
            if key not in self.tiles:
                self.tiles[key] = make_stone_tile(th).to_image(th["sky"])
        elif ch == "?":
            pulse = (self.frame // 20) % 2
            key = ("q", pulse)
            if key not in self.tiles:
                self.tiles[key] = make_q_tile(pulse, False).to_image(th["sky"])
        elif ch == "U":
            key = ("u",)
            if key not in self.tiles:
                self.tiles[key] = make_q_tile(0, True).to_image(th["sky"])
        else:   # "T"
            top = row == 0 or self.grid[row - 1][col] != "T"
            left = col in self.pipe_left
            key = ("T", tkey, top, left)
            if key not in self.tiles:
                self.tiles[key] = make_pipe_tile(top, left, th["pipe"]).to_image(th["sky"])
        return self.tiles[key], 0

    def prewarm(self):
        """Bölümdeki tüm doku çeşitlerini oyun başlamadan üret (takılma olmasın)."""
        saved = self.frame
        for pulse_frame in (0, 20):
            self.frame = pulse_frame
            for row in range(ROWS):
                for col in range(self.cols):
                    ch = self.grid[row][col]
                    if ch in "#BS?UT":
                        self.get_tile(ch, row, col)
        self.frame = saved

    # ---- çizim: dünya
    def draw_coin(self, sx, sy, col):
        c = self.canvas
        bob = math.sin(self.frame * 0.08 + col * 0.7) * 2
        y = sy + bob
        c.create_oval(sx + 8, y + 8, sx + 32, y + 32, fill="#f5b800", outline="#a06800", width=2)
        c.create_oval(sx + 11, y + 11, sx + 29, y + 29, outline="#ffd84a")
        c.create_text(sx + 20, y + 20, text="C", font=("Arial", 13, "bold"), fill="white")

    def draw_flag(self, sx, sy, row):
        c = self.canvas
        c.create_rectangle(sx + 18, sy, sx + 22, sy + TILE, fill="#eeeeee", outline="#888888")
        if row == 1:
            wave_y = math.sin(self.frame * 0.12) * 3
            c.create_polygon(sx + 22, sy + 4, sx + 40, sy + 8 + wave_y, sx + 54, sy + 16,
                             sx + 40, sy + 22 - wave_y, sx + 22, sy + 28,
                             fill="#e02020", outline="#801010")
        elif row == 0:
            c.create_oval(sx + 14, sy + 2, sx + 26, sy + 14, fill="#ffd700", outline="#b8860b")

    def draw_checkpoints(self):
        c = self.canvas
        for col in self.checks:
            sx = col * TILE - int(self.cam)
            if -60 < sx < W + 20:
                reached = self.checkpoint is not None and self.checkpoint >= col * TILE + 6
                c.create_rectangle(sx + 19, 10 * TILE - 58, sx + 22, 10 * TILE,
                                   fill="#cccccc", outline="#777777")
                c.create_polygon(sx + 22, 10 * TILE - 58, sx + 42, 10 * TILE - 50,
                                 sx + 22, 10 * TILE - 42,
                                 fill="#2ecc40" if reached else "#ffd84a", outline="#555555")

    def draw_background(self):
        c, th = self.canvas, self.theme
        cam = self.cam
        c.create_rectangle(0, 0, W, H, fill=th["sky"], outline="")
        deco = th["deco"]
        if deco == "hills":
            for i in range(14):
                cx = i * 380 + (i % 3) * 60 - cam * 0.25
                if -320 < cx < W + 40:
                    w, h = 260 + (i % 3) * 60, 90 + (i % 2) * 30
                    c.create_arc(cx, 400 - h, cx + w, 400 + h, start=0, extent=180,
                                 fill="#3fa84a", outline="")
            for i in range(14):
                cx = i * 300 + 120 + (i % 2) * 50 - cam * 0.5
                if -260 < cx < W + 40:
                    w, h = 200 + (i % 2) * 50, 60 + (i % 3) * 14
                    c.create_arc(cx, 400 - h, cx + w, 400 + h, start=0, extent=180,
                                 fill="#58c458", outline="")
            for i in range(14):
                cx = i * 430 + 100 - cam * 0.5
                cy = 50 + (i % 3) * 38
                if -120 < cx < W + 120:
                    for dx, dw in ((0, 60), (30, 70), (60, 60)):
                        c.create_oval(cx + dx, cy, cx + dx + dw, cy + 34, fill="white", outline="")
        elif deco == "cave":
            for i in range(60):
                sx = (i * 97 - cam * 0.3) % W
                sy = (i * 53) % 260
                col = "white" if (i + self.frame // 20) % 5 else "#8888cc"
                c.create_rectangle(sx, sy, sx + 2, sy + 2, fill=col, outline="")
            for i in range(10):
                sx = (i * 90 - cam * 0.6) % 900 - 50
                h = 40 + (i % 3) * 22
                c.create_polygon(sx, 0, sx + 56, 0, sx + 28, h, fill="#1c1c3c", outline="")
        elif deco == "lava":
            pillar = th.get("pillar", "#3a1212")
            for i in range(10):
                bx = (i * 300 + 60 - cam * 0.4) % (W + 200) - 100
                c.create_rectangle(bx, 140 + (i % 3) * 30, bx + 70, 400, fill=pillar, outline="")
                c.create_rectangle(bx + 24, 170 + (i % 3) * 30, bx + 34, 190 + (i % 3) * 30,
                                   fill="#ffb000" if (self.frame // 15 + i) % 3 else "#7a3a10",
                                   outline="")
            for x in range(0, W + 40, 40):
                off = math.sin(self.frame * 0.1 + x * 0.05) * 4
                c.create_rectangle(x, 412 + off, x + 40, H, fill="#ff5a10", outline="")
                c.create_rectangle(x, 412 + off, x + 40, 420 + off, fill="#ffb000", outline="")
        elif deco == "snow":
            for i in range(10):
                cx = i * 340 + 60 - cam * 0.2
                if -360 < cx < W + 60:
                    w, h = 300 + (i % 3) * 60, 150 + (i % 2) * 40
                    c.create_polygon(cx, 400, cx + w / 2, 400 - h, cx + w, 400,
                                     fill="#86abd2", outline="")
                    off = 44 * (w / 2) / h
                    c.create_polygon(cx + w / 2, 400 - h, cx + w / 2 - off, 400 - h + 44,
                                     cx + w / 2 + off, 400 - h + 44, fill="#f4fbff", outline="")
            for i in range(45):
                fx = (i * 97 + math.sin(self.frame * 0.02 + i) * 18 - cam * 0.5) % W
                fy = (i * 31 + self.frame * (0.7 + (i % 3) * 0.35)) % H
                c.create_oval(fx, fy, fx + 3, fy + 3, fill="white", outline="")
        elif deco == "desert":
            c.create_oval(610, 28, 740, 158, fill="#ffe27a", outline="")
            c.create_oval(630, 48, 720, 138, fill="#fff3b0", outline="")
            for i in range(8):
                bx = i * 520 + 100 - cam * 0.3
                if -280 < bx < W + 40:
                    c.create_polygon(bx, 400, bx + 130, 276, bx + 260, 400,
                                     fill="#d9a441", outline="")
                    c.create_polygon(bx + 130, 276, bx + 260, 400, bx + 130, 400,
                                     fill="#b8832c", outline="")
            for i in range(12):
                dx = i * 300 - cam * 0.5
                if -320 < dx < W + 40:
                    c.create_arc(dx, 350, dx + 340, 450, start=0, extent=180,
                                 fill="#e8b85a", outline="")
        elif deco == "haunted":
