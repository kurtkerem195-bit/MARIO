        d = DIFFICULTIES[st["difficulty"]]
        c.create_text(W / 2, 398,
                      text=f"{d['name']}: {d['lives']} can, canavar hızı x{d['speed']}, XP x{d['xp']}"
                           "   (Zorluk/oyuncu sayısı bölüm başlayınca geçerli olur)",
                      font=("Arial", 10), fill="#aaaadd")
        ok, text = self.snd.status()
        c.create_text(W / 2, 418, text="Ses durumu: " + text, font=("Arial", 10, "bold"),
