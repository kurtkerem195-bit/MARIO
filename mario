    def draw_plant(self, e):
        """Pipoya gizlenen bitki. Borudan ÖNCE çizilir, böylece boru gövdesi onu örter."""
        c = self.canvas
        cx = int(e.cx - self.cam)
        if cx < -60 or cx > W + 60:
            return
        top, ext = e.top, e.ext
        hy = top - ext + 20
        c.create_rectangle(cx - 5, hy, cx + 5, top + 18, fill="#2a9a2a", outline="#146014")
        c.create_polygon(cx - 5, hy + 18, cx - 26, hy + 8, cx - 8, hy + 30,
                         fill="#2fb02f", outline="#146014")
        c.create_polygon(cx + 5, hy + 18, cx + 26, hy + 8, cx + 8, hy + 30,
                         fill="#2fb02f", outline="#146014")
        c.create_oval(cx - 17, hy - 17, cx + 17, hy + 17, fill="#d82020", outline="#7a0a0a", width=2)
        for dx, dy, r in ((-10, -10, 3), (6, -12, 3), (-2, 8, 3), (11, 4, 2)):
            c.create_oval(cx + dx - r, hy + dy - r, cx + dx + r, hy + dy + r, fill="white", outline="")
        if (self.frame // 8) % 2 == 0:                      # ağzı açık: dişli
            c.create_oval(cx - 13, hy - 3, cx + 13, hy + 11, fill="#2a0508", outline="")
            for tx in (-10, -3, 4):
                c.create_polygon(cx + tx, hy - 3, cx + tx + 6, hy - 3, cx + tx + 3, hy + 4,
                                 fill="white", outline="")
        else:
            c.create_line(cx - 13, hy + 3, cx + 13, hy + 3, fill="#2a0508", width=3)

    def draw_enemy(self, e):
        c = self.canvas
        k = e.kind
        if k == "plant":
            return
        x, y = int(e.x - self.cam), int(e.y)
        if x < -80 or x > W + 80:
            return
        if not e.alive:
            if e.exploded:                                  # bomba patlaması
                t = 24 - e.squash
                r = 14 + t * 3.4
                cx, cy = x + 16, y + 16
                c.create_oval(cx - r, cy - r, cx + r, cy + r, fill="#ff6a00", outline="#ffb000", width=3)
                c.create_oval(cx - r * 0.66, cy - r * 0.66, cx + r * 0.66, cy + r * 0.66,
                              fill="#ffb000", outline="")
                c.create_oval(cx - r * 0.33, cy - r * 0.33, cx + r * 0.33, cy + r * 0.33,
                              fill="#fff3a0", outline="")
                return
            col = {"walker": "#8b4513", "spiky": "#c02020", "hopper": "#30a030",
                   "flyer": "#7030a0", "penguin": "#23233a", "bomb": "#222222"}.get(k, "#555555")
            c.create_rectangle(x, y + e.h - 8, x + 32, y + e.h, fill=col, outline="black")
            return
        if k == "walker":
            sh = 3 if (self.frame // 8) % 2 else 0
            c.create_oval(x, y, x + 32, y + 26, fill="#8b4513", outline="#3a1a05")
            c.create_rectangle(x + 2 + sh, y + 22, x + 14 + sh, y + 32, fill="#3a1a05", outline="")
            c.create_rectangle(x + 18 - sh, y + 22, x + 30 - sh, y + 32, fill="#3a1a05", outline="")
            self._eyes(x, y + 7)
        elif k == "spiky":
            for sx in (2, 12, 22):
                c.create_polygon(x + sx, y + 10, x + sx + 4, y - 4, x + sx + 8, y + 10,
                                 fill="#eeeeee", outline="#777777")
            c.create_oval(x, y + 4, x + 32, y + 28, fill="#c02020", outline="#601010")
            c.create_rectangle(x + 3, y + 24, x + 13, y + 32, fill="#601010", outline="")
            c.create_rectangle(x + 19, y + 24, x + 29, y + 32, fill="#601010", outline="")
            self._eyes(x, y + 11)
            c.create_line(x + 5, y + 9, x + 14, y + 13, fill="black", width=2)
            c.create_line(x + 27, y + 9, x + 18, y + 13, fill="black", width=2)
        elif k == "hopper":
            air = not e.on_ground
            c.create_oval(x, y + 8, x + 32, y + 30, fill="#30a030", outline="#106010")
            c.create_oval(x + 3, y, x + 15, y + 12, fill="white", outline="#106010")
            c.create_oval(x + 17, y, x + 29, y + 12, fill="white", outline="#106010")
            c.create_oval(x + 7, y + 3, x + 11, y + 9, fill="black", outline="")
            c.create_oval(x + 21, y + 3, x + 25, y + 9, fill="black", outline="")
            leg = 4 if air else 0
            c.create_rectangle(x + 1, y + 28, x + 11, y + 32 + leg, fill="#106010", outline="")
            c.create_rectangle(x + 21, y + 28, x + 31, y + 32 + leg, fill="#106010", outline="")
        elif k == "flyer":
            up = (self.frame // 8) % 2 == 0
            wy = y + (2 if up else 20)
            c.create_polygon(x + 10, y + 14, x - 8, wy, x + 8, y + 22,
                             fill="#5a2090", outline="#2a0a50")
            c.create_polygon(x + 22, y + 14, x + 40, wy, x + 24, y + 22,
                             fill="#5a2090", outline="#2a0a50")
            c.create_oval(x + 8, y + 6, x + 24, y + 26, fill="#7030a0", outline="#2a0a50")
            c.create_oval(x + 11, y + 12, x + 15, y + 16, fill="red", outline="")
            c.create_oval(x + 17, y + 12, x + 21, y + 16, fill="red", outline="")
            c.create_polygon(x + 10, y + 8, x + 12, y, x + 15, y + 8, fill="#7030a0", outline="")
            c.create_polygon(x + 17, y + 8, x + 20, y, x + 22, y + 8, fill="#7030a0", outline="")
        elif k == "penguin":
            d = e.dir
            sh = 3 if (self.frame // 6) % 2 else 0
            if e.dash > 0:                                  # hız çizgileri
                for off in (6, 14, 22):
                    c.create_line(x + 16 - d * 22, y + off, x + 16 - d * 36, y + off,
                                  fill="white", width=2)
            c.create_oval(x, y, x + 32, y + 30, fill="#23233a", outline="#0b0b18")
            c.create_oval(x + 7, y + 8, x + 25, y + 30, fill="#f4f4f8", outline="")
            bx = x + 16 + d * 6
            c.create_polygon(bx, y + 10, bx + d * 10, y + 14, bx, y + 18,
                             fill="#ff9a1a", outline="#a05a00")
            c.create_oval(x + 8, y + 4, x + 15, y + 12, fill="white", outline="")
            c.create_oval(x + 17, y + 4, x + 24, y + 12, fill="white", outline="")
            c.create_oval(x + 10 + d, y + 6, x + 13 + d, y + 11, fill="black", outline="")
            c.create_oval(x + 19 + d, y + 6, x + 22 + d, y + 11, fill="black", outline="")
            c.create_rectangle(x + 4 + sh, y + 28, x + 14 + sh, y + 32, fill="#ff9a1a", outline="")
            c.create_rectangle(x + 18 - sh, y + 28, x + 28 - sh, y + 32, fill="#ff9a1a", outline="")
        elif k == "bomb":
            lit = e.state == "lit"
            flash = lit and (self.frame // 4) % 2 == 0
            c.create_oval(x, y + 6, x + 32, y + 32, fill="#d82020" if flash else "#1e1e1e",
                          outline="#000000", width=2)
            c.create_oval(x + 5, y + 10, x + 12, y + 17, fill="#666666", outline="")
            c.create_line(x + 16, y + 6, x + 22, y - 1, fill="#8a5a1a", width=3)
            sp = 5 if (self.frame // 3) % 2 else 3
            c.create_polygon(x + 22, y - 1 - sp, x + 22 + sp // 2 + 1, y - 1, x + 22, y - 1 + sp,
                             x + 22 - sp // 2 - 1, y - 1, fill="#ffd000", outline="#ff6a00")
            c.create_oval(x + 8, y + 16, x + 15, y + 24, fill="white", outline="")
            c.create_oval(x + 18, y + 16, x + 25, y + 24, fill="white", outline="")
            c.create_oval(x + 10, y + 18, x + 13, y + 23, fill="black", outline="")
            c.create_oval(x + 20, y + 18, x + 23, y + 23, fill="black", outline="")
        elif k == "ghost":
            body = "#eeeeff"
            c.create_oval(x, y, x + 30, y + 24, fill=body, outline="#8888cc")
            c.create_polygon(x, y + 12, x, y + 30, x + 7, y + 24, x + 15, y + 30,
                             x + 23, y + 24, x + 30, y + 30, x + 30, y + 12,
                             fill=body, outline="#8888cc")
            if e.chasing:
                c.create_oval(x + 6, y + 7, x + 13, y + 15, fill="black", outline="")
                c.create_oval(x + 17, y + 7, x + 24, y + 15, fill="black", outline="")
                c.create_oval(x + 9, y + 17, x + 21, y + 26, fill="#331144", outline="")
            else:                                           # utangaç: elleriyle yüzünü kapatır
                c.create_oval(x + 3, y + 6, x + 15, y + 17, fill="#cfcff0", outline="#8888cc")
                c.create_oval(x + 15, y + 6, x + 27, y + 17, fill="#cfcff0", outline="#8888cc")
        elif k == "lavaball":
            if e.state != "fly" or e.y > H + 30:
                return
            tail = 1 if e.vy < 0 else -1
            c.create_polygon(x + 5, y + 13 + tail * 8, x + 13, y + 13 + tail * 30,
                             x + 21, y + 13 + tail * 8, fill="#ff9a00", outline="")
            c.create_oval(x - 6, y - 6, x + 32, y + 32, fill="#7a2000", outline="")
            c.create_oval(x, y, x + 26, y + 26, fill="#ff6a00", outline="#ffb000", width=2)
            c.create_oval(x + 6, y + 6, x + 20, y + 20, fill="#ffe060", outline="")

    def _eyes(self, x, y):
        c = self.canvas
        c.create_oval(x + 6, y, x + 14, y + 10, fill="white", outline="")
        c.create_oval(x + 18, y, x + 26, y + 10, fill="white", outline="")
        c.create_oval(x + 9, y + 3, x + 13, y + 9, fill="black", outline="")
        c.create_oval(x + 19, y + 3, x + 23, y + 9, fill="black", outline="")

    def overlay(self, text, sub=""):
        c = self.canvas
        c.create_rectangle(0, H / 2 - 70, W, H / 2 + 70, fill="#0b0b1e", outline="#ffffff", width=2)
        c.create_text(W / 2, H / 2 - 15, text=text, fill="white", font=("Arial", 30, "bold"))
        if sub:
            c.create_text(W / 2, H / 2 + 30, text=sub, fill="#dddddd", font=("Arial", 13))

    def draw_world(self):
        c = self.canvas
        self.draw_background()
        for e in self.enemies:                              # bitkiler borunun arkasında
            if e.kind == "plant":
                self.draw_plant(e)

        cam = int(self.cam)
        first = cam // TILE
        for col in range(first, min(self.cols, first + W // TILE + 2)):
            sx = col * TILE - cam
            for row in range(ROWS):
                ch = self.grid[row][col]
                if ch == ".":
                    continue
                sy = row * TILE
                if ch == "o":
                    self.draw_coin(sx, sy, col)
                    continue
                if ch == "F":
                    self.draw_flag(sx, sy, row)
                    continue
                f = self.bumped.get((col, row))
                if f:                                   # kafa vurulan blok zıplar
                    sy -= round(9 * math.sin(math.pi * (BUMP_FRAMES - f) / BUMP_FRAMES))
                img, dy = self.get_tile(ch, row, col)
                c.create_image(sx, sy + dy, image=img, anchor="nw")

        self.draw_checkpoints()
        for e in self.enemies:
            self.draw_enemy(e)

        multi = len(self.players) > 1
        for pl in self.players:
            if pl.out or pl.dead_t > 0:
                continue
            if pl.invuln > 0 and (pl.invuln // 4) % 2 == 0:
                continue
            step = 3 if (abs(pl.vx) > 0.5 and pl.on_ground and (self.frame // 6) % 2) else 0
            px, py = int(pl.x - self.cam), int(pl.y)
            draw_mario(c, px, py, pl.face, resolve_look(self.equipped_of(pl.idx)), 1.0, step)
            if multi:
                c.create_text(px + 14, py - 12, text=str(pl.idx + 1),
                              fill="white" if pl.idx == 0 else "#9dff9d",
                              font=("Arial", 11, "bold"))

        for x, y, vx, vy, life in self.particles:       # toz bulutları
            r = 2 + 3 * life / 18
            c.create_oval(x - self.cam - r, y - r, x - self.cam + r, y + r,
                          fill="#e6dccb", outline="")
        for text, wx, wy, life, col in self.popups:
            c.create_text(wx - self.cam, wy, text=text, fill=col, font=("Arial", 14, "bold"))

        y0 = 10
        for pl in self.players:
            tag = f"{pl.idx + 1}P " if multi else ""
            hud = f"{tag}PUAN {pl.score:06d}  C x{pl.coins:02d}  CAN x{max(pl.lives, 0)}"
            col = "white" if pl.idx == 0 else "#9dff9d"
            c.create_text(12, y0 + 2, text=hud, anchor="nw", fill="black", font=("Courier", 14, "bold"))
            c.create_text(10, y0, text=hud, anchor="nw", fill=col, font=("Courier", 14, "bold"))
            y0 += 20
        snd_on = self.snd.enabled and self.snd.engine
        info = f"XP {self.save['xp']}  ·  {self.diff['name']}  ·  " + ("♪ açık" if snd_on else "♪ KAPALI")
        c.create_text(W - 9, 11, text=self.spec["name"], anchor="ne", fill="black", font=("Arial", 12, "bold"))
        c.create_text(W - 10, 10, text=self.spec["name"], anchor="ne", fill="white", font=("Arial", 12, "bold"))
        c.create_text(W - 9, 31, text=info, anchor="ne", fill="black", font=("Arial", 11, "bold"))
        c.create_text(W - 10, 30, text=info, anchor="ne", fill="#7df9ff", font=("Arial", 11, "bold"))

        if self.snd.enabled and self.snd.error:
            c.create_text(W / 2, H - 10, text=f"Ses hatası: {self.snd.error[:70]}  (S > Ses sihirbazı)",
                          fill="#ff8080", font=("Arial", 9, "bold"))
        if self.state == "play" and not multi:
            pl = self.players[0]
            if pl.dead_t > 0 and not pl.out:
                self.overlay("Öldün!", f"Kalan can: {pl.lives}")
        if self.state == "pause":
            self.overlay("DURAKLADI", "P: devam   S: ayarlar   R: yeniden başla   ESC: menü")
        elif self.state == "over":
            self.overlay("OYUN BİTTİ",
                         "ENTER: tekrar dene   K: özelleştir   S: ayarlar   ESC: menü")
        elif self.state == "levelwin":
            last = self.level_idx + 1 >= len(LEVELS)
            title = "TÜM BÖLÜMLER BİTTİ!  ★" if last else "BÖLÜM TAMAM!  ★"
            nxt = "ENTER: menüye dön" if last else "ENTER: sonraki bölüm"
            scores = "   ".join((f"{p.idx + 1}P: {p.score}" if multi else f"Puan: {p.score}")
                               for p in self.players)
            self.overlay(title, f"{scores}   —   {nxt}   K: özelleştir")

