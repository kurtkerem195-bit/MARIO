        scores = list(scores) if scores else []
        scores = (scores + [0] * n)[:n]
        self.players = [Player(i, self.diff["lives"]) for i in range(n)]
        for pl, sc in zip(self.players, scores):
            pl.score = sc
        self.base_scores = list(scores)
        self.assign_keys()
        self.checks = [self.snap_check(c) for c in self.spec["checks"]]
        self.checkpoint = None
        self.popups = []
        self.particles = []
        self.bumped = {}
        self.state = "play"
        self.prewarm()
        for pl in self.players:
            self.spawn(pl, start=True)
        self.look = 0.0
        self.snap_camera()

    def begin_run(self, idx):
        self.start_level(idx, [0, 0])

    def restart_level(self):
        self.start_level(self.level_idx, self.base_scores)

    def assign_keys(self):
        if len(self.players) == 1:
            self.players[0].keymap = KEYS_SOLO
        else:
            self.players[0].keymap = KEYS_P1
            self.players[1].keymap = KEYS_P2

    def snap_check(self, col):
        """Kontrol noktasını en yakın güvenli zemine kaydır."""
        def ok(c):
            if not (2 <= c < self.cols - 6):
                return False
            for cc in (c - 1, c, c + 1):
                if self.grid[10][cc] != "#":
                    return False
                if self.grid[9][cc] not in ".o" or self.grid[8][cc] not in ".o":
                    return False
            for e in self.enemies:
                if e.kind == "lavaball":
                    continue
                ex = e.cx if e.kind == "plant" else e.x
                if abs(ex - c * TILE) < 130:
                    return False
            return True
        for d in range(0, 16):
            for c in (col - d, col + d):
                if ok(c):
                    return c
        return col

    def spawn_point(self, pl, start):
        base = (self.checkpoint if self.checkpoint is not None else 2 * TILE + 6)
        x, y = base + (pl.idx * 36 if start else 0), 10 * TILE - 36
        if not start:
            other = next((q for q in self.players if q is not pl and not q.out
                          and q.dead_t == 0 and q.safe_x is not None), None)
            if other is not None:
                x, y = other.safe_x, other.safe_y
        return x, y

    def spawn(self, pl, start=False):
        pl.x, pl.y = self.spawn_point(pl, start)
        pl.vx = pl.vy = 0.0
        pl.on_ground = False
        pl.dead_t = 0
        pl.invuln = 90 if start else self.diff["invuln"]
        pl.coyote = pl.jump_buf = 0
        pl.air_jumps = MAX_AIR_JUMPS
        pl.safe_x, pl.safe_y = pl.x, pl.y

    def snap_camera(self):
        al = [p for p in self.players if not p.out]
        if not al:
            return
        mid = sum(p.x for p in al) / len(al) + 14
        frac = 0.4 if len(self.players) == 1 else 0.5
        self.cam = max(0, min(self.cols * TILE - W, mid - W * frac))

    def alive_players(self):
        return [p for p in self.players if not p.out and p.dead_t == 0]

    def say(self, text, frames=90):
        self.toast, self.toast_t = text, frames

    # ---- girdi
    def on_focus_out(self, e=None):
        self.keys.clear()
        self.pending_release.clear()

    def on_down(self, e):
        k = e.keysym.lower()
        if k in self.pending_release:       # X11 oto-tekrarı: bırakma+basma çifti
            self.pending_release.discard(k)
            self.keys.add(k)
            return
        fresh = k not in self.keys          # tuş basılı tutulursa tekrar saymaz
        self.keys.add(k)
        if fresh:
            self.on_press(k)

    def on_up(self, e):
        k = e.keysym.lower()
        self.pending_release.add(k)
        self.root.after(12, self.finish_release, k)

    def finish_release(self, k):
        if k in self.pending_release:
            self.pending_release.discard(k)
            self.keys.discard(k)

    def on_resize(self, e=None):
        w = self.cv.winfo_width() or 0
        h = self.cv.winfo_height() or 0
        if w >= 100 and h >= 100:
            self.canvas.fit(w, h, self.settings["fs_crisp"])

    def set_fullscreen(self, on):
        self.fullscreen = on
        self.settings["fullscreen"] = on
        try:
            if on:
                self.root.resizable(True, True)
                self.root.attributes("-fullscreen", True)
            else:
                self.root.attributes("-fullscreen", False)
                self.root.resizable(False, False)
                self.cv.config(width=W, height=H)
                self.root.geometry("")
        except Exception as ex:
            self.say(f"Tam ekran açılamadı: {ex}", 150)
            self.fullscreen = self.settings["fullscreen"] = False
        self.root.after(200, self.on_resize)
        self.write_save()

    def toggle_fullscreen(self):
        self.set_fullscreen(not self.fullscreen)

    def on_click(self, e):
        if self.state != "menu":
            return
        mx = (e.x - self.canvas.ox) / self.canvas.f
        my = (e.y - self.canvas.oy) / self.canvas.f
        for i, (name, _, _, _) in enumerate(MENU_BUTTONS):
            x1, y1, x2, y2 = button_rect(i)
            if x1 <= mx <= x2 and y1 <= my <= y2:
                if name == "start":
                    self.snd.play("start")
                    self.begin_run(self.sel_level)
                elif name == "shop":
                    self.snd.play("select")
                    self.open_shop("menu")
                else:
                    self.snd.play("select")
                    self.open_settings("menu")
                return
        for i in range(len(LEVELS)):
            x1, y1, x2, y2 = card_rect(i)
            if x1 <= mx <= x2 and y1 <= my <= y2:
                if self.sel_level == i:
                    self.snd.play("start")
                    self.begin_run(i)
                else:
                    self.sel_level = i
                    self.snd.play("select")

    def open_settings(self, came_from):
        self.settings_from = came_from
        self.state = "settings"

    def toggle_sound(self):
        self.settings["sound"] = not self.settings["sound"]
        self.write_save()
        self.say("Ses: AÇIK" if self.settings["sound"] else "Ses: KAPALI")
        if self.settings["sound"]:
            self.snd.play("select")

    def on_press(self, k):
        if k == "f11":
            self.toggle_fullscreen()
            return
        if k == "m":
            self.toggle_sound()
            return
        st = self.state
        if st == "menu":
            n = len(LEVELS)
            moved = None
            if k == "left":
                moved = max(0, self.sel_level - 1)
            elif k == "right":
                moved = min(n - 1, self.sel_level + 1)
            elif k == "up":
                moved = self.sel_level - 4 if self.sel_level >= 4 else self.sel_level
            elif k == "down":
                moved = self.sel_level + 4 if self.sel_level + 4 < n else self.sel_level
            elif k.isdigit() and 1 <= int(k) <= n:
                moved = int(k) - 1
            if moved is not None:
                if moved != self.sel_level:
                    self.snd.play("select")
                self.sel_level = moved
            elif k in ENTER_KEYS:
                self.snd.play("start")
                self.begin_run(self.sel_level)
            elif k == "k":
                self.snd.play("select")
                self.open_shop("menu")
            elif k == "s":
                self.snd.play("select")
                self.open_settings("menu")
            elif k == "p":
                self.settings["players"] = 2 if self.settings["players"] == 1 else 1
                self.write_save()
                self.snd.play("equip")
        elif st == "settings":
            row = self.set_row
            if k == "up":
                self.set_row = (row - 1) % len(SETTINGS_ROWS)
                self.snd.play("select")
            elif k == "down":
                self.set_row = (row + 1) % len(SETTINGS_ROWS)
                self.snd.play("select")
            elif k in ("left", "right"):
                self.settings_adjust(row, -1 if k == "left" else 1)
            elif k in ENTER_KEYS:
                self.settings_adjust(row, 0)
            elif k in ("escape", "s", "backspace"):
                self.state = self.settings_from
        elif st == "wizard":
            self.wizard_key(k)
        elif st == "controls":
            if k in ("escape", "return", "kp_enter", "backspace", "s"):
                self.state = "settings"
        elif st == "shop":
            row = self.shop_row
            n = len(CATS[row][2])
            if k == "up":
                self.shop_row = (row - 1) % len(CATS)
                self.snd.play("select")
            elif k == "down":
                self.shop_row = (row + 1) % len(CATS)
                self.snd.play("select")
            elif k == "left":
                self.shop_col[row] = max(0, self.shop_col[row] - 1)
                self.snd.play("select")
            elif k == "right":
                self.shop_col[row] = min(n - 1, self.shop_col[row] + 1)
                self.snd.play("select")
            elif k == "tab":
                self.shop_player = 1 - self.shop_player
                self.load_shop_cols()
                self.snd.play("select")
            elif k in ENTER_KEYS:
                self.shop_action()
            elif k in ("escape", "k", "backspace"):
                self.state = self.shop_from
        elif st == "play":
            for pl in self.players:
                if k in pl.keymap["jump"]:
                    pl.jump_buf = JUMP_BUFFER
            if k == "p":
                self.state = "pause"
                self.snd.play("pause")
            elif k == "r":
                self.restart_level()
            elif k == "escape":
                self.state = "menu"
        elif st == "pause":
            if k in ("p", "return", "kp_enter"):
                self.state = "play"
                self.snd.play("pause")
            elif k == "s":
                self.open_settings("pause")
            elif k == "r":
                self.restart_level()
            elif k == "escape":
                self.state = "menu"
        elif st == "over":
            if k in ENTER_KEYS or k == "r":
                self.restart_level()
            elif k == "k":
                self.open_shop("over")
            elif k == "s":
                self.open_settings("over")
            elif k == "escape":
                self.state = "menu"
        elif st == "levelwin":
            if k in ENTER_KEYS:
                if self.level_idx + 1 < len(LEVELS):
                    self.start_level(self.level_idx + 1, [p.score for p in self.players])
                else:
                    self.state = "menu"
            elif k == "k":
                self.open_shop("levelwin")
            elif k == "s":
                self.open_settings("levelwin")
            elif k == "escape":
                self.state = "menu"

    # ---- ayarlar
    def settings_adjust(self, row, d):
        st = self.settings
        name = SETTINGS_ROWS[row]
        if name == "sound":
            self.toggle_sound()
            return
        if name == "volume" and d != 0:
            st["volume"] = max(0, min(100, st["volume"] + d * 10))
            if self.vol_job is not None:
                try:
                    self.root.after_cancel(self.vol_job)
                except Exception:
                    pass
            self.vol_job = self.root.after(250, self.apply_volume)
        elif name == "engine" and d != 0:
            choices = ["auto"] + self.snd.engines
            cur = choices.index(st["engine"]) if st["engine"] in choices else 0
            st["engine"] = choices[(cur + d) % len(choices)]
            self.snd.error = ""
            self.snd.set_engine(st["engine"])
            self.snd.play("select")
        elif name == "test" and d == 0:
            self.sound_test()
        elif name == "wizard" and d == 0:
            self.start_wizard()
            return
        elif name == "difficulty" and d != 0:
            st["difficulty"] = max(0, min(2, st["difficulty"] + d))
        elif name == "players" and d != 0:
            st["players"] = 2 if st["players"] == 1 else 1
        elif name == "fullscreen":
            self.toggle_fullscreen()
            return
        elif name == "fsmode" and d != 0:
            st["fs_crisp"] = not st["fs_crisp"]
            self.on_resize()
        elif name == "controls" and d == 0:
            self.state = "controls"
            return
        elif name == "back" and d == 0:
            self.state = self.settings_from
            return
        else:
            return
        self.write_save()

    def apply_volume(self):
        self.vol_job = None
        self.snd.apply_volume()
        self.snd.play("select")

    def sound_test(self):
        self.snd.error = ""
        self.snd.play("jump")
        self.root.after(280, lambda: self.snd.play("coin"))
        self.root.after(600, lambda: self.snd.play("win"))
        ok, text = self.snd.status()
        if not self.settings["sound"]:
            self.say("Ses KAPALI: önce sesi aç (M)", 150)
        else:
            self.say(("Test çalındı - " if ok else "SES HATASI - ") + text, 220)


    # ---- ses sihirbazı
    def start_wizard(self):
        self.settings["sound"] = True
        self.write_save()
        self.wiz = {"stage": "intro" if self.snd.engines else "none", "i": 0,
                    "engines": list(self.snd.engines), "results": {}, "err": "", "report": ""}
        self.state = "wizard"

    def wizard_play(self, i):
        w = self.wiz
        w["i"], w["stage"] = i, "ask"
        self.snd.error = ""
        self.snd.set_engine(w["engines"][i])
        w["err"] = self.snd.test_play("test_tone")

    def wizard_short_demo(self):
        for delay, name in ((0, "jump"), (500, "coin"), (1000, "stomp_walker"), (1500, "win")):
            if delay == 0:
                self.snd.play(name)
            else:
                self.root.after(delay, lambda n=name: self.snd.play(n))

    def wizard_finish(self, ok):
        self.settings["sound_ok"] = ok
        self.write_save()
        text = self.snd.report(self.wiz["results"])
        path = os.path.join(_HERE, "ses_raporu.txt")
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text + "\n")
            self.wiz["report"] = path
        except OSError:
            self.wiz["report"] = "(rapor dosyası yazılamadı)"

    def end_wizard(self):
        self.snd.set_engine(self.settings["engine"])
        self.state = "settings"

    def wizard_key(self, k):
        w = self.wiz
        st = w["stage"]
        if k == "escape":
            self.end_wizard()
            return
        if st == "intro":
            if k in ENTER_KEYS:
                self.wizard_play(0)
        elif st == "ask":
            eng = w["engines"][w["i"]]
            if k == "t":
                self.wizard_play(w["i"])
            elif k == "e":
                w["results"][eng] = "uzun ses duyuldu"
                self.settings["engine"] = eng
                self.snd.set_engine(eng)
                w["stage"] = "short"
                self.wizard_short_demo()
            elif k == "h":
                w["results"][eng] = "ses duyulmadi" + (f" (hata: {w['err']})" if w["err"] else "")
                if w["i"] + 1 < len(w["engines"]):
                    self.wizard_play(w["i"] + 1)
                else:
                    w["stage"] = "fail"
                    self.wizard_finish(False)
        elif st == "short":
            eng = w["engines"][w["i"]]
            if k == "t":
                self.wizard_short_demo()
            elif k == "e":
                w["results"][eng] += ", kisa oyun sesleri de duyuldu"
                w["stage"] = "done"
                self.wizard_finish(True)
            elif k == "h":
                w["results"][eng] += ", kisa oyun sesleri DUYULMADI"
                w["stage"] = "partial"
                self.wizard_finish(False)
        elif st in ("done", "partial", "fail", "none"):
            if k in ENTER_KEYS:
                self.end_wizard()

