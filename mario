DIE_SOUNDS = {"spiky": "die_spiky", "plant": "die_plant", "ghost": "die_ghost",
              "lavaball": "die_lava", "bomb": None}


def build_samples(segments):
    out = []
    for seg in segments:
        tracks = [_synth(*voice) for voice in seg]
        out += _mix(*tracks) if len(tracks) > 1 else tracks[0]
    return out


def build_tones(segments):
    """Sadece 'Bip' motoru için: (frekans, ms) listesi. frekans 0 = sessizlik."""
    tones = []
    for seg in segments:
        f0, f1, dur, vol, wt = seg[0][:5]
        ms = max(20, int(dur * 1000))
        if vol <= 0:
            tones.append((0, ms))
        else:
            f = 160 if wt == "noise" else int((f0 + f1) / 2)
            tones.append((max(37, min(32000, f)), ms))
    return tones


def write_wav(path, samples, gain):
    data = array.array("h", (int(max(-0.98, min(0.98, s * gain)) * 32767) for s in samples))
    if sys.byteorder == "big":
        data.byteswap()
    with wave.open(path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(data.tobytes())


def render_sounds(folder, volume=80):
    """Tüm sesleri WAV olarak yazar. {ad: (yol, süre_sn, öncelik)} döner."""
    out = {}
    gain = volume / 100.0 * 2.0
    for name, (segs, prio) in SOUND_DEFS.items():
        samples = build_samples(segs)
        path = os.path.join(folder, name + ".wav")
        write_wav(path, samples, gain)
        out[name] = (path, len(samples) / RATE, prio)
    return out


class WAVEFORMATEX(ctypes.Structure):
    _pack_ = 1
    _fields_ = [("wFormatTag", ctypes.c_ushort), ("nChannels", ctypes.c_ushort),
                ("nSamplesPerSec", ctypes.c_uint32), ("nAvgBytesPerSec", ctypes.c_uint32),
                ("nBlockAlign", ctypes.c_ushort), ("wBitsPerSample", ctypes.c_ushort),
                ("cbSize", ctypes.c_ushort)]


class WAVEHDR(ctypes.Structure):
    _fields_ = [("lpData", ctypes.c_void_p), ("dwBufferLength", ctypes.c_uint32),
                ("dwBytesRecorded", ctypes.c_uint32), ("dwUser", ctypes.c_size_t),
                ("dwFlags", ctypes.c_uint32), ("dwLoops", ctypes.c_uint32),
                ("lpNext", ctypes.c_void_p), ("reserved", ctypes.c_size_t)]


WAVE_MAPPER = 0xFFFFFFFF
WHDR_DONE = 0x1

CMDS = {"afplay": ["afplay"], "paplay": ["paplay"], "pw-play": ["pw-play"],
        "aplay": ["aplay", "-q"], "play": ["play", "-q"],
        "ffplay": ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet"]}
