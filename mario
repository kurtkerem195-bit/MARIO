def draw_mario(c, x, y, face, look, scale=1.0, step=0):
    """Mario'yu (x, y) sol-üst köşesine çizer. 28x36 piksel * scale."""
    s = scale

    def R(x1, y1, x2, y2, col, mirror=False):
        if mirror and face < 0:
            x1, x2 = 28 - x1, 28 - x2
        c.create_rectangle(x + x1 * s, y + y1 * s, x + x2 * s, y + y2 * s,
                           fill=col, outline="")

    def P(pts, col, mirror=False):
        flat = []
        for px, py in pts:
            if mirror and face < 0:
                px = 28 - px
            flat += [x + px * s, y + py * s]
        c.create_polygon(*flat, fill=col, outline="")

    hat, overall, boots, acc = look["hat"], look["overall"], look["boots"], look["acc"]
    if "cape" in acc:
        P([(5, 18), (-8, 28), (-10, 42), (8, 34)], "#d01040", True)
    R(2 + step, 30, 12 + step, 36, boots)              # botlar
    R(16 - step, 30, 26 - step, 36, boots)
    R(2 + step, 30, 12 + step, 32, shade(boots, 0.25))  # bot parlaması
    R(16 - step, 30, 26 - step, 32, shade(boots, 0.25))
    R(2, 18, 26, 28, hat)                              # gömlek
    R(5, 22, 23, 32, overall)                          # tulum
    R(3, 8, 25, 18, "#ffcc99")                         # yüz
    R(2, 0, 26, 8, hat)                                # şapka
    R(14, 6, 30, 10, hat, True)                        # siper
    R(17, 10, 21, 14, "black", True)                   # göz
    if "mustache" in acc:
        R(10, 14, 26, 17, "#3a1a05", True)
    if "shades" in acc:
        R(5, 9, 25, 14, "#111111")
        R(8, 10, 11, 12, "#666666")
        R(17, 10, 20, 12, "#666666")
    if "bowtie" in acc:
        P([(14, 19), (7, 16), (7, 23)], "#ff3b6b")
        P([(14, 19), (21, 16), (21, 23)], "#ff3b6b")
        R(12, 17, 16, 21, "#c01040")
    if "crown" in acc:
        P([(4, 2), (4, -7), (9, -2), (14, -9), (19, -2), (24, -7), (24, 2)], "#ffd700")


