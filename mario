    # ---- bölüm yönetimi
    def start_level(self, idx, scores=None):
        self.level_idx = idx
        self.spec = LEVELS[idx]
        self.theme = THEMES[self.spec["theme"]]
        self.cols = self.spec["cols"]
        self.grid = build_level(self.spec)
        self.pipe_left = {col for col, _ in self.spec["pipes"]}
        self.diff = DIFFICULTIES[self.settings["difficulty"]]
        self.enemies = [make_enemy(t[0], t[1], t[2] if len(t) > 2 else None,
                                   self.spec, self.diff["speed"])
                        for t in self.spec["enemies"]]
